{
  "name": "cazweb-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:clean:force_stop_all_processes": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*@playwright/test*test-server*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; if (Test-Path 'test-results') { Remove-Item -Recurse -Force 'test-results' }\"",
    "test:test": "playwright test --project=e2e-chromium",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:setup": "playwright test --project=auth-desktop --project=auth-mobile",
    "test:visual": "playwright test --project=visual",
    "test:totogaming": "cross-env PARTNER=totogaming playwright test --project=e2e-chromium",
    "test:totoro": "cross-env PARTNER=totoro playwright test --project=e2e-chromium",
    "test:totogaming:prod:web": "cross-env PARTNER=totogaming PLAYWRIGHT_ENV=prod playwright test --project=e2e-chromium ",
    "test:totogaming:prod:mobile": "cross-env PARTNER=totogaming PLAYWRIGHT_ENV=prod playwright test  --project=e2e-mobile-chromium",
    "test:totoro:prod": "cross-env PARTNER=totoro PLAYWRIGHT_ENV=prod playwright test --project=e2e-chromium",
    "test:cozbet_shared:prod": "cross-env PARTNER=cozbet_shared PLAYWRIGHT_ENV=prod playwright test --project=e2e-chromium",
    "test:betfa:prod:web": "cross-env PARTNER=betfa PLAYWRIGHT_ENV=prod playwright test --project=e2e-chromium",
    "test:betfa:prod:mobile": "cross-env PARTNER=betfa PLAYWRIGHT_ENV=prod playwright test --project=e2e-mobile-chromium",
    "test:positive": "cross-env TEST_TYPE=positive playwright test",
    "test:negative": "cross-env TEST_TYPE=negative playwright test",
    "test:all": "cross-env TEST_TYPE=all playwright test",
    "test:smoke": "cross-env TEST_TYPE=positive TEST_TAG=smoke playwright test",
    "test:regression": "cross-env TEST_TYPE=positive TEST_TAG=regression playwright test",
    "test:login:all": "node scripts/run-login-all-partners.js",
    "test:login:all:negative": "node scripts/run-login-all-partners.js --type=negative",
    "test:login:all:full": "node scripts/run-login-all-partners.js --type=all",
    "test:register:all": "node scripts/run-register-all-partners.js",
    "test:register:all:negative": "node scripts/run-register-all-partners.js --type=negative",
    "test:register:all:full": "node scripts/run-register-all-partners.js --type=all",
    "test:suite": "node scripts/run-all.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "cross-env": "^10.1.0"
  }
}