{
  "name": "cazweb-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright E2E framework for Cazweb partner sites",
  "scripts": {
    "test": "playwright test",
    "test:positive": "cross-env TEST_TYPE=positive playwright test",
    "test:negative": "cross-env TEST_TYPE=negative playwright test",
    "test:all": "cross-env TEST_TYPE=all playwright test",
    "test:smoke": "cross-env TEST_TYPE=positive TEST_TAG=smoke playwright test",
    "test:regression": "cross-env TEST_TYPE=positive TEST_TAG=regression playwright test",
    "test:headed": "playwright test --headed",
    "test:setup": "playwright test --project=auth-desktop --project=auth-mobile",
    "test:report": "playwright show-report",
    "test:clean:force_stop_all_processes": "powershell -NoProfile -Command \"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*@playwright/test*test-server*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; foreach ($d in 'test-results','playwright-report','blob-report','blob-report-merged','artifacts') { if (Test-Path $d) { Remove-Item -Recurse -Force $d } }\"",


    "test:feature": "node scripts/run-feature.js",
    "test:cashier:totogaming": "node scripts/run-feature.js cashier totogaming --workers=2",
    "test:cashier:totoro": "node scripts/run-feature.js cashier totoro --workers=2",
    "test:lobby:totogaming": "node scripts/run-feature.js lobby totogaming --workers=2",
    "test:lobby:totoro": "node scripts/run-feature.js lobby totoro --workers=2",


    "test:login:totogaming": "node scripts/run-feature.js login totogaming --workers=2",
    "test:login:totoro": "node scripts/run-feature.js login totoro --workers=2",
    "test:login:shared_partners": "node scripts/run-feature.js login cozbet --workers=2",
    "test:login:albatross_partners": "node scripts/run-feature.js login betfa --workers=2",


    "test:login:all": "node scripts/run-feature.js login --parallel=2 --workers=2",
    "test:login:all:negative": "node scripts/run-feature.js login totogaming totoro --parallel=2 --workers=2 --type=negative",
    "test:login:all:full": "node scripts/run-feature.js login totogaming totoro --parallel=2 --workers=2 --type=all",

    "test:register:totogaming": "node scripts/run-feature.js register totogaming --workers=2",
    "test:register:totoro": "node scripts/run-feature.js register totoro --workers=2",
    "test:register:cozbet": "node scripts/run-feature.js register cozbet --workers=2",
    "test:register:betfa": "node scripts/run-feature.js register betfa --workers=2",
    "test:register:all": "node scripts/run-feature.js register totogaming totoro --workers=2",

    "test:suite": "node scripts/run-all.js --parallel=2 --workers=2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "cross-env": "^10.1.0"
  }
}