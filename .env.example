# Environment file template.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real secrets.

# Which partner to target by default (see src/config/partners.js)
PARTNER=totogaming

# Which environment to target. NOTE: the currently registered partners only
# configure `prod`, so this must be `prod`. Requesting an environment that is
# not configured for the selected partner fails with a clear error instead of
# silently falling back to another environment.
PLAYWRIGHT_ENV=test

# B2B Registration API — used by the auth setup to create a FRESH player per
# run/device. TEST_API_URL is the API base URL (the client appends
# /Client/Register); B2B_AUTH is the raw token sent in the Authorization header
# (NO "Bearer" prefix). If either is missing the setup fails loudly and
# dependent projects are skipped.
TEST_API_URL=https://websitewebapi.tst-digi.com/api/v1
B2B_AUTH=

# B2B Registration API — PRODUCTION. Used by the auth setup when
# PLAYWRIGHT_ENV=prod (fresh prod players for login/change-password/inbox).
# Get the URL/token from the dev team. The lobby feature does NOT use these; it
# logs in with the shared prod player below (TOTOGAMING_PROD_USERNAME/_PASSWORD).
PROD_API_URL=
PROD_B2B_AUTH=

# ── Legacy shared accounts (OPTIONAL) ──────────────────────
# The auth/e2e suites now register fresh players via the B2B Registration API
# above and no longer use these. They are reserved for future Betting tests;
# leaving them empty is fine for every current suite.
#
# TotoGaming (https://totogaming.am/)
TOTOGAMING_PROD_USERNAME=
TOTOGAMING_PROD_PASSWORD=
# Optional: a separate mobile account (single-session platforms).
TOTOGAMING_PROD_USERNAME_MOBILE=
TOTOGAMING_PROD_PASSWORD_MOBILE=

# TotoGaming RO / "totoro" (https://totogaming.ro/en)
TOTOGAMINGRO_PROD_USERNAME=
TOTOGAMINGRO_PROD_PASSWORD=

# Cozbet Shared (https://cozbet002.com/en)
COZBET_SHARED_PROD_USERNAME=
COZBET_SHARED_PROD_PASSWORD=

# Betfa (https://betfa.com/)
BETFA_PROD_USERNAME=
BETFA_PROD_PASSWORD=

# Template for additional partners: the env-var prefix must match the partner's
# `credsEnvPrefix` in src/config/partners.js, environment segment uppercased:
#   <PREFIX>_<ENV>_USERNAME / <PREFIX>_<ENV>_PASSWORD
# PARTNER2_PROD_USERNAME=
# PARTNER2_PROD_PASSWORD=