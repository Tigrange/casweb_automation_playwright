# Environment file template.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real secrets.

# Which partner to target by default (see src/config/partners.js)
PARTNER=totogaming

# Which environment to target by default: test | prod
PLAYWRIGHT_ENV=test

# ── TotoGaming ─────────────────────────────────────────────
# Test environment (https://totogaming.tst-digi.com/)
TOTOGAMING_TEST_USERNAME=
TOTOGAMING_TEST_PASSWORD=

# Production environment (https://totogaming.am/) — rarely used
TOTOGAMING_PROD_USERNAME=
TOTOGAMING_PROD_PASSWORD=

# ── TotoGaming RO ─────────────────────────────────────────
TOTOGAMINGRO_TEST_USERNAME=
TOTOGAMINGRO_TEST_PASSWORD=
TOTOGAMINGRO_PROD_USERNAME=
TOTOGAMINGRO_PROD_PASSWORD=

# ── Template for additional partners ──────────────────────
# PARTNER2_TEST_USERNAME=
# PARTNER2_TEST_PASSWORD=
# PARTNER2_PROD_USERNAME=
# PARTNER2_PROD_PASSWORD=